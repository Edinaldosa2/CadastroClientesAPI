@baseUrl = http://localhost:5105
@token = Bearer cole-o-jwt-aqui
@id = 00000000-0000-0000-0000-000000000000

### Catalog
GET {{baseUrl}}/api

### Health
GET {{baseUrl}}/health/ready

### Login editor
POST {{baseUrl}}/api/v1/auth/token
Content-Type: application/json

{
  "usuario": "editor",
  "senha": "editor-dev"
}

### List customers
GET {{baseUrl}}/api/v1/clientes?pagina=1&tamanhoPagina=20&ordenarPor=nome&contato=@example.com
Authorization: {{token}}

### Cursor page
GET {{baseUrl}}/api/v1/clientes?depoisDe={{id}}
Authorization: {{token}}

### Create person
POST {{baseUrl}}/api/v1/clientes
Authorization: {{token}}
Content-Type: application/json
Idempotency-Key: demo-joao

{
  "nome": "João da Silva",
  "tipoPessoa": "Fisica",
  "documento": "11144477735",
  "dataNascimento": "1985-03-10",
  "enderecos": [
    {
      "tipo": "Residencial",
      "logradouro": "Rua Augusta",
      "numero": "200",
      "bairro": "Consolação",
      "cidade": "São Paulo",
      "uf": "SP",
      "cep": "01305000",
      "principal": true
    }
  ],
  "contatos": [
    {
      "tipo": "Email",
      "valor": "joao@example.com",
      "principal": true
    }
  ]
}

### Get by document
GET {{baseUrl}}/api/v1/clientes/documento/11144477735
Authorization: {{token}}

### Replace with If-Match
PUT {{baseUrl}}/api/v1/clientes/{{id}}
Authorization: {{token}}
Content-Type: application/json
If-Match: "etag-do-get"

{
  "nome": "João da Silva Souza"
}

### Add address
POST {{baseUrl}}/api/v1/clientes/{{id}}/enderecos
Authorization: {{token}}
Content-Type: application/json

{
  "tipo": "Comercial",
  "logradouro": "Avenida Paulista",
  "numero": "1578",
  "bairro": "Bela Vista",
  "cidade": "São Paulo",
  "uf": "SP",
  "cep": "01310200",
  "principal": false
}

### Unlock blocked customer
POST {{baseUrl}}/api/v1/clientes/{{id}}/ativar
Authorization: {{token}}
Content-Type: application/json

{
  "motivo": "revisão cadastral"
}

### Audit trail
GET {{baseUrl}}/api/v1/clientes/{{id}}/auditoria
Authorization: {{token}}

### Summary report
GET {{baseUrl}}/api/v1/relatorios/clientes/resumo
Authorization: {{token}}

### CSV export (escrita)
GET {{baseUrl}}/api/v1/relatorios/clientes/exportar
Authorization: {{token}}
